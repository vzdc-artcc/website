{
  "name": "vzdc_website",
  "version": "1.4.0",
  "author": "Aneesh Reddy & vZDC",
  "private": true,
  "scripts": {
    "db:reset": "dotenv -e .env.local -- npx prisma migrate reset",
    "db:migrate": "dotenv -e .env.local -- npx prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- npx prisma migrate deploy",
    "studio": "dotenv -e .env.local -- npx prisma studio",
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@faire/mjml-react": "^4.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/x-charts": "^9.14.0",
    "@mui/x-data-grid": "^9.14.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@next/third-parties": "^16.3.8",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@types/mjml": "^5.0.0",
    "@uiw/react-markdown-editor": "^6.1.4",
    "ag-charts-community": "^14.2.0",
    "ag-charts-react": "^14.2.0",
    "bad-words": "^4.1.5",
    "csv-stringify": "^6.9.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "ics": "^3.12.1",
    "mjml": "^5.4.1",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.1",
    "prisma": "~7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-markdown": "^9.1.0",
    "react-material-ui-carousel": "^3.4.2",
    "react-toastify": "^10.0.6",
    "sharp": "^0.35.5",
    "uploadthing": "^7.7.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bad-words": "^3.0.3",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.26.0",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "react-material-ui-carousel": {
      "react": "$react",
      "react-dom": "$react-dom",
      "@mui/material": "$@mui/material",
      "@mui/icons-material": "$@mui/icons-material"
    }
  }
}
