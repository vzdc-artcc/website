DEV_MODE=true

# Base URL of the osmium API. Browser code calls this directly (with
# credentials) so it must be reachable from the client, not just the server.
# osmium's own default BIND_ADDR is also 3000, which collides with Next's
# default dev port — run osmium on a different port locally (e.g. 3900).
# Use "localhost", not "127.0.0.1" — Next dev blocks HMR/client hydration for
# non-allowlisted origins, and 127.0.0.1 vs localhost are also different
# "sites" for SameSite cookie purposes (osmium_session wouldn't be sent).
NEXT_PUBLIC_OSMIUM_API_URL=http://localhost:3900

# Cloudflare Turnstile site key for the captcha widget (Staffing/Feedback forms).
# Pair with osmium's TURNSTILE_SECRET_KEY. Use Cloudflare's test key
# 1x00000000000000000000AA for local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# VATUSA — still called directly by a few server actions (actions/vatusa/*).
VATUSA_FACILITY=ZDC
VATUSA_API_KEY=

# TeamSpeak lookup proxy (app/api/teamspeak). OSMIUM_SERVICE_TOKEN is an osmium
# service-account bearer token holding `auth.teamspeak_uids.read`; the optional
# OSMIUM_INTERNAL_API_URL overrides the public base for that server-to-server call.
TS_KEY=
OSMIUM_SERVICE_TOKEN=
OSMIUM_INTERNAL_API_URL=

# Training/event scheduling config.
TRAINING_ENVIRONMENTS=SBX1,SBX2
BUFFER_TIME=15
SUAS=

# Optional donation link shown in the footer.
NEXT_PUBLIC_DONATION_URL=
