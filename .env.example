DEV_MODE=true

# Base URL of the osmium API. Browser code calls this directly (with
# credentials) so it must be reachable from the client, not just the server.
# osmium's own default BIND_ADDR is also 3000, which collides with Next's
# default dev port — run osmium on a different port locally (e.g. 3900).
# Use "localhost", not "127.0.0.1" — Next dev blocks HMR/client hydration for
# non-allowlisted origins, and 127.0.0.1 vs localhost are also different
# "sites" for SameSite cookie purposes (osmium_session wouldn't be sent).
NEXT_PUBLIC_OSMIUM_API_URL=http://localhost:3900

NEXT_PUBLIC_GOOGLE_CAPTCHA_SITE_KEY=
GOOGLE_CAPTCHA_SECRET_KEY=

DATABASE_URL="postgresql://postgres:admin@localhost:5432/website_6?schema=public"
POSTGRES_USER=
POSTGRES_PASS=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=test # Use openssl rand -hex 32 to generate

VATSIM_CLIENT_ID=
VATSIM_CLIENT_SECRET=

VATUSA_FACILITY=ZDC
VATUSA_API_KEY=

UPLOADTHING_TOKEN=

AWS_SMTP_FROM=Virtual Washington ARTCC <no-reply@vzdc.org>
AWS_SMTP_REGION=us-east-1
AWS_SMTP_ACCESS_KEY_ID=
AWS_SMTP_SECRET_ACCESS_KEY=

TS_KEY=
# osmium service-account bearer token used by the /api/teamspeak proxy to call
# osmium's TeamSpeak lookup endpoint. Provision an osmium API key holding
# `auth.teamspeak_uids.read`. Optional OSMIUM_INTERNAL_API_URL overrides the
# public base for this server-to-server call.
OSMIUM_SERVICE_TOKEN=
OSMIUM_INTERNAL_API_URL=

TRAINING_ENVIRONMENTS=SBX1,SBX2
BUFFER_TIME=15

SUAS=

NEXT_PUBLIC_DONATION_URL=

ATC_BOOKING_TOKEN=

UPDATER_KEY=

WEB_TEAM_MEMBERS=1652726,1084263,1544104

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=
DISCORD_CLIENT_SECRET=

# Discord Bot Testing
DISCORD_TRAINING_CHANNEL_CREATE_URL=
DISCORD_EVENT_POSITION_POST_URL=
BOT_API_BASE_URL=
BOT_API_SECRET_KEY=
DISCORD_GUILD_ID=
